$ORIGIN .
$TTL 38400		; 10 hours 40 minutes
avado		IN SOA	avado. administrator.avado. (
				2026110501 ; serial
				10800      ; refresh (3 hours)
				3600       ; retry (1 hour)
				604800     ; expire (1 week)
				60         ; minimum: "does not exist" answers are cached for 1 minute only
				)
			NS	172.33.1.2
$ORIGIN avado.
my			A	172.33.1.9
ipfs			A	172.33.1.5
dappmanager	A	172.33.1.7
wamp A 172.33.1.8
remoteconnect A 172.33.1.20
